(PID.TID 0004.0001) >#               > 0 : write time-average output every stat_freq seconds
(PID.TID 0004.0001) >#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
(PID.TID 0004.0001) >#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
