(PID.TID 0002.0001) >#outp.stream n
(PID.TID 0002.0001) >#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
(PID.TID 0002.0001) >#               > 0 : write time-average output every stat_freq seconds
(PID.TID 0002.0001) >#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
(PID.TID 0002.0001) >#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
(PID.TID 0002.0001) >#  stat_fields(:,n) : list of diagnostics fields (8.c) (see
(PID.TID 0002.0001) >#"available_diagnostics.log"
